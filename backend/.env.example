# ==========================================
# SURAJAI BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

NODE_ENV=development
PORT=5000
APP_NAME=SurajAI
APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Database
DATABASE_URL="mysql://root:@localhost:3306/surajai"

# Authentication Secrets
JWT_SECRET=surajai_jwt_secret_dev_key_2026_secure
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=surajai_refresh_secret_dev_key_2026_secure
REFRESH_TOKEN_EXPIRES_IN=7d

# AI Provider Configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=your_real_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

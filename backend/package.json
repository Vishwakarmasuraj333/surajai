{
  "name": "@surajai/backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "test": "tsx src/tests/platform.test.ts",
    "test:ai": "tsx src/services/ai/ai.test.ts",
    "build": "prisma generate && node ../node_modules/typescript/bin/tsc",
    "start": "node dist/server.js",
    "typecheck": "node ../node_modules/typescript/bin/tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push --accept-data-loss"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "openai": "^7.4.0",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.8.6",
    "tsx": "^4.19.2"
  }
}

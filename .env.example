# ==========================================
# SURAJAI ENVIRONMENT CONFIGURATION
# ==========================================

# --- APP CONFIGURATION ---
NODE_ENV=development
PORT=5000
APP_NAME=SurajAI
APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# --- DATABASE CONFIGURATION ---
DATABASE_URL="mysql://root:password@localhost:3306/surajai_db"

# --- AUTHENTICATION ---
JWT_SECRET=your_super_secret_jwt_access_key_change_in_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key_change_in_production
REFRESH_TOKEN_EXPIRES_IN=7d

# --- AI PROVIDERS CONFIGURATION ---
# Supported providers: gemini | openai | anthropic
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL=gemini-1.5-pro

# Fallback AI Provider (Optional)
FALLBACK_AI_PROVIDER=openai
FALLBACK_AI_API_KEY=

# --- EMBEDDINGS & VECTOR STORE ---
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=your_gemini_api_key_here
VECTOR_STORE_TYPE=in_memory # Options: in_memory | pgvector | pinecone

# --- WEB SEARCH TOOLS ---
SEARCH_PROVIDER=tavily # Options: tavily | serper
SEARCH_API_KEY=

# --- FILE STORAGE ---
STORAGE_PROVIDER=local # Options: local | s3
MAX_FILE_SIZE_MB=10

# --- RATE LIMITING ---
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
